const fetch = require("node-fetch");
const apiKey = process.env.PERPLEXITY_API_KEY;

exports.getPlaceInfoFromPerplexity = async (placeName) => {
  console.log("Perplexity API 호출 준비 중");
  
  const prompt = `다음 장소에 대한 정보를 반드시 JSON 형식으로 알려줘. 정보는 공식 사이트에서 주로 받아와.
장소 이름: ${placeName}
반드시 다음과 같은 키를 포함해서 아래 형식으로 응답해줘:
{
  "name": "장소 이름",
  "location": "정확한 위치 (주소)",
  "hours": "운영시간",
  "description": "이 장소를 설명하는 한 문장"
}`;

  const response = await fetch('https://api.perplexity.ai/chat/completions', {
    method: 'POST',
    headers: {
      'Authorization': `Bearer ${apiKey}`,
      'Content-Type': 'application/json',
    },
    body: JSON.stringify({
      model: 'sonar-pro',
      messages: [
        {
          role: 'user',
          content: prompt
        },
      ],
    }),
  });

  const text = await response.text();
  console.log("📡 Perplexity 응답 상태코드:", response.status);
  console.log("🧾 Perplexity 원시 응답 텍스트:", text);

  if (!response.ok) {
    console.error("Perplexity API 요청 실패:", text);
    throw new Error('Perplexity API 호출 실패');
  }

  // 1차 JSON 파싱
  let contentText;
  try {
    const outer = JSON.parse(text);
    contentText = outer.choices?.[0]?.message?.content;
    console.log("응답 content 추출 성공");
  } catch (e) {
    console.error("1차 JSON 파싱 실패:", e);
    throw new Error("Perplexity 응답 구조가 예상과 다릅니다.");
  }

  // 내부 JSON 파싱
  try {
    const jsonStart = contentText.indexOf('{');
    const jsonEnd = contentText.lastIndexOf('}');
    const jsonOnly = contentText.slice(jsonStart, jsonEnd + 1);
    const parsed = JSON.parse(jsonOnly);
    console.log("최종 JSON 파싱 결과:", parsed);
    return parsed;
  } catch (e) {
    console.error("내부 JSON 파싱 실패:", e);
    throw new Error("Perplexity가 JSON 형식으로 응답하지 않았습니다.");
  }
};
